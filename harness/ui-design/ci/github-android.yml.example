# Copy only after reviewing the actual project, host paths, devices and upload manifest.
# Require approval for ALL external fork contributors before registering a runner.
# The temporary runner owns no service and accepts only reviewed owner-authored work.
name: Android Native UI
on:
  pull_request:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: android-native-ui-${{ github.repository }}
  cancel-in-progress: false
jobs:
  android-native-tests:
    name: android-native-tests
    if: github.event.pull_request.head.repo.full_name == github.repository && github.actor == github.repository_owner && github.event.pull_request.user.login == github.repository_owner
    runs-on: [self-hosted, macOS, ARM64, harness-android-trial]
    timeout-minutes: 90
    env:
      CHECKED_SHA: ${{ github.event.pull_request.head.sha }}
      UI_AUTHORITY_URL: ${{ vars.UI_AUTHORITY_URL }}
      # ANDROID_MENU_HOST_CONFIG is set by the reviewed runner launch wrapper.
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Prepare fixed checker and UI history
        shell: bash
        run: |
          set -euo pipefail
          mkdir "$RUNNER_TEMP/android-evidence"
          test "$(git rev-parse HEAD)" = "$CHECKED_SHA"
          test -n "$UI_AUTHORITY_URL"
          test -f "$ANDROID_MENU_HOST_CONFIG"
          python3.13 -m venv "$RUNNER_TEMP/android-ui-tools"
          "$RUNNER_TEMP/android-ui-tools/bin/python" -m pip install --require-hashes -r harness/ui-design/config/requirements.lock
          echo "UI_DESIGN_PYTHON=$RUNNER_TEMP/android-ui-tools/bin/python" >> "$GITHUB_ENV"
          git -c core.hooksPath=/dev/null clone --no-single-branch "$UI_AUTHORITY_URL" "$RUNNER_TEMP/android-ui-authority"
      - name: Check current fixed UI inputs
        shell: bash
        run: |
          set -euo pipefail
          "$UI_DESIGN_PYTHON" -B harness/ui-design/ci/check_inputs.py \
            --root "$PWD" --head "$CHECKED_SHA" --config harness/ui-ci/context.json \
            --ui-repository "$RUNNER_TEMP/android-ui-authority" --output "$RUNNER_TEMP/android-evidence/ui-inputs.json"
      - name: Verify platform rejection and interaction readiness
        shell: bash
        run: |
          set -euo pipefail
          "$UI_DESIGN_PYTHON" -B -m unittest discover -s tests/android-menu -p 'test_*.py' -v
      - name: Build and execute exact native matrix
        shell: bash
        run: |
          set -euo pipefail
          "$UI_DESIGN_PYTHON" -B harness/ui-design/ci/android-native.py \
            --root "$PWD" --head "$CHECKED_SHA" --config harness/ui-ci/android-native.json \
            --host-config "$ANDROID_MENU_HOST_CONFIG" --output "$RUNNER_TEMP/android-evidence/native"
      - name: Recheck current UI authority
        shell: bash
        run: |
          set -euo pipefail
          "$UI_DESIGN_PYTHON" -B harness/ui-design/ci/check_inputs.py \
            --root "$PWD" --head "$CHECKED_SHA" --config harness/ui-ci/context.json \
            --ui-repository "$RUNNER_TEMP/android-ui-authority" --output "$RUNNER_TEMP/android-evidence/ui-inputs-after.json"
      - name: Retain success or failure evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: android-native-ui-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/android-evidence
          if-no-files-found: error
          retention-days: 14
  android-native-ui:
    name: android-native-ui
    needs: android-native-tests
    if: always()
    runs-on: ubuntu-24.04
    timeout-minutes: 1
    steps:
      - name: Require an executed successful native job
        env:
          NATIVE_RESULT: ${{ needs.android-native-tests.result }}
        shell: bash
        run: |
          set -euo pipefail
          test "$NATIVE_RESULT" = success
